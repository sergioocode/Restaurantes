{
  "realm": "restaurantes",
  "enabled": true,
  "loginWithEmailAllowed": true,
  "registrationAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "clients": [
    {
      "clientId": "${IDENTITY_KEYCLOAK_CLIENT_ID}",
      "name": "Restaurantes Identity",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${IDENTITY_KEYCLOAK_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5001/api/identity/auth/callback/keycloak",
        "http://localhost:5001/api/identity/auth/logout-callback/keycloak"
      ],
      "webOrigins": ["http://localhost:5001"],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email"]
    }
  ],

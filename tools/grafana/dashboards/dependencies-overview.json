      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [ "lastNotNull" ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (((rate(http_client_request_duration_seconds_bucket{job=\"otel-collector\",service_name=~\"${service}\",exported_instance=~\"${process}\",server_port!~\"${otlp:raw}\",server_address=~\"${destination}\",server_port=~\"${port}\"}[5m])) and on (service_name, exported_instance) dotnet_assembly_count{job=\"otel-collector\",service_name=~\"${service}\",exported_instance=~\"${process}\"}) and on() (up{job=\"otel-collector\"} == 1)))",
          "refId": "A",
          "legendFormat": "Latencia p95 · últimos 5 min",
          "instant": true,
          "range": false,
          "format": "time_series",
          "interval": "1m"
        }
      ],
      "title": "Latencia p95 · últimos 5 min",
      "type": "stat"
    },

{
  "annotations": { "list": [] },
  "description": "Llamadas HTTP salientes de APIs y gateways. Selección de servicio, instancia y destino; tráfico OTLP oculto por defecto.",
  "editable": false,
  "links": [
    {
      "title": "Dashboards de Restaurantes",
      "type": "dashboards",
      "tags": [ "restaurantes", "observability" ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Comprueba el scrape del Collector; no comprueba la salud de las aplicaciones.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No accesible",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Accesible",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [ "lastNotNull" ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "up{job=\"otel-collector\"}",
          "refId": "A",
          "legendFormat": "Collector · acceso desde Prometheus",
          "instant": true,
          "range": false,
          "format": "time_series",
          "interval": "1m"
        }
      ],
      "title": "Collector · acceso desde Prometheus",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Cuenta las instancias seleccionadas que aún tienen series runtime publicadas en el Collector. No es una prueba de salud ni garantiza que el proceso siga vivo: el Collector conserva temporalmente las últimas métricas. Sin series, se muestra «Sin datos».",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [ "lastNotNull" ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "(count(dotnet_assembly_count{job=\"otel-collector\",service_name=~\"${service}\",exported_instance=~\"${process}\"})) and on() (up{job=\"otel-collector\"} == 1)",
          "refId": "A",
          "legendFormat": "Instancias con series runtime disponibles",
          "instant": true,
          "range": false,
          "format": "time_series",
          "interval": "1m"
        }
      ],
      "title": "Instancias con series runtime disponibles",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Incremento estimado. Filtra los destinos por dirección y puerto; oculta OTLP por defecto.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [ "lastNotNull" ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(((increase(http_client_request_duration_seconds_count{job=\"otel-collector\",service_name=~\"${service}\",exported_instance=~\"${process}\",server_port!~\"${otlp:raw}\",server_address=~\"${destination}\",server_port=~\"${port}\"}[5m])) and on (service_name, exported_instance) dotnet_assembly_count{job=\"otel-collector\",service_name=~\"${service}\",exported_instance=~\"${process}\"}) and on() (up{job=\"otel-collector\"} == 1))",
          "refId": "A",
          "legendFormat": "Llamadas salientes · últimos 5 min",
          "instant": true,
          "range": false,
          "format": "time_series",
          "interval": "1m"
        }
      ],
      "title": "Llamadas salientes · últimos 5 min",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Cuenta error_type no vacío: errores de transporte y respuestas clasificadas como error por HttpClient, incluidos 4xx y 5xx. No equivale solo a errores 5xx.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [ "lastNotNull" ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(((increase(http_client_request_duration_seconds_count{job=\"otel-collector\",service_name=~\"${service}\",exported_instance=~\"${process}\",server_port!~\"${otlp:raw}\",server_address=~\"${destination}\",server_port=~\"${port}\",error_type!=\"\"}[5m])) and on (service_name, exported_instance) dotnet_assembly_count{job=\"otel-collector\",service_name=~\"${service}\",exported_instance=~\"${process}\"}) and on() (up{job=\"otel-collector\"} == 1)) or (0 * sum(((increase(http_client_request_duration_seconds_count{job=\"otel-collector\",service_name=~\"${service}\",exported_instance=~\"${process}\",server_port!~\"${otlp:raw}\",server_address=~\"${destination}\",server_port=~\"${port}\"}[5m])) and on (service_name, exported_instance) dotnet_assembly_count{job=\"otel-collector\",service_name=~\"${service}\",exported_instance=~\"${process}\"}) and on() (up{job=\"otel-collector\"} == 1)))",
          "refId": "A",
          "legendFormat": "Llamadas con error · últimos 5 min",
          "instant": true,
          "range": false,
          "format": "time_series",
          "interval": "1m"
        }
      ],
      "title": "Llamadas con error · últimos 5 min",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Latencia de las llamadas HTTP salientes seleccionadas.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sin datos",

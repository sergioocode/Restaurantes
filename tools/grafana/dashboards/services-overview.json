    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Estimación del histograma HTTP. Con pocas peticiones es poco representativa; no mide el tiempo de un pedido hasta aparecer en KDS.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sin datos",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [ "lastNotNull" ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (((rate(http_server_request_duration_seconds_bucket{job=\"otel-collector\",service_name=~\"${service}\",exported_instance=~\"${process}\",service_name!~\"Restaurantes[.]Gateway[.].+\",service_name!=\"\",http_route=~\"/?api/.*\",http_route=~\"${route}\",http_request_method=~\"${method}\"}[5m])) and on (service_name, exported_instance) dotnet_assembly_count{job=\"otel-collector\",service_name=~\"${service}\",exported_instance=~\"${process}\"}) and on() (up{job=\"otel-collector\"} == 1)))",
          "refId": "A",
          "legendFormat": "Latencia p95 · últimos 5 min",
          "instant": true,
          "range": false,
          "format": "time_series",
          "interval": "1m"
        }
      ],
      "title": "Latencia p95 · últimos 5 min",
      "type": "stat"
    },
    {

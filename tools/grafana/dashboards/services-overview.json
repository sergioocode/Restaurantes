      "targets": [
        {
          "expr": "sum(((increase(http_server_request_duration_seconds_count{job=\"otel-collector\",service_name=~\"${service}\",exported_instance=~\"${process}\",service_name!~\"Restaurantes[.]Gateway[.].+\",service_name!=\"\",http_route=~\"/?api/.*\",http_route=~\"${route}\",http_request_method=~\"${method}\",http_response_status_code=~\"5..\"}[5m])) and on (service_name, exported_instance) dotnet_assembly_count{job=\"otel-collector\",service_name=~\"${service}\",exported_instance=~\"${process}\"}) and on() (up{job=\"otel-collector\"} == 1)) or (0 * sum(((increase(http_server_request_duration_seconds_count{job=\"otel-collector\",service_name=~\"${service}\",exported_instance=~\"${process}\",service_name!~\"Restaurantes[.]Gateway[.].+\",service_name!=\"\",http_route=~\"/?api/.*\",http_route=~\"${route}\",http_request_method=~\"${method}\"}[5m])) and on (service_name, exported_instance) dotnet_assembly_count{job=\"otel-collector\",service_name=~\"${service}\",exported_instance=~\"${process}\"}) and on() (up{job=\"otel-collector\"} == 1)))",
          "refId": "A",
          "legendFormat": "Respuestas 5xx · últimos 5 min",
          "instant": true,
          "range": false,
          "format": "time_series",
          "interval": "1m"
        }
      ],
      "title": "Respuestas 5xx · últimos 5 min",
      "type": "stat"

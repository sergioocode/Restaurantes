          "expr": "sum by (service_name) (((rate(http_server_request_duration_seconds_count{job=\"otel-collector\",service_name=~\"${service}\",exported_instance=~\"${process}\",service_name!~\"Restaurantes[.]Gateway[.].+\",service_name!=\"\",http_route=~\"/?api/.*\",http_route=~\"${route}\",http_request_method=~\"${method}\"}[$__rate_interval])) and on (service_name, exported_instance) dotnet_assembly_count{job=\"otel-collector\",service_name=~\"${service}\",exported_instance=~\"${process}\"}) and on() (up{job=\"otel-collector\"} == 1))",

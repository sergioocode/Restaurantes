{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "restaurant-operations": {
        "ClusterId": "restaurant-operations",
        "Match": {
          "Path": "/api/restaurant-operations/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "dining": {
        "ClusterId": "dining",
        "Match": { "Path": "/api/dining/{**catch-all}" }
      },
      "catalog-read": {
        "ClusterId": "catalog-read",
        "Match": {
          "Path": "/api/catalog/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "orders-read": {
        "ClusterId": "orders-read",
        "Match": {
          "Path": "/api/orders/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "orders-write": {
        "ClusterId": "orders-write",
        "Match": {
          "Path": "/api/orders/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      },
      "payments-write": {
        "ClusterId": "payments-write",
        "Match": {
          "Path": "/api/payments/{**catch-all}",
          "Methods": [ "POST" ]
        }
      },
      "sales-read": {
        "ClusterId": "sales-read",
        "Match": {
          "Path": "/api/sales/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "reporting-api": {
        "ClusterId": "reporting",
        "Match": { "Path": "/api/reporting/{**catch-all}" }
      },
      "reporting-hub": {
        "ClusterId": "reporting",
        "Match": { "Path": "/hubs/reporting/{**catch-all}" }
      },
      "reporting-dashboard": {
        "ClusterId": "dashboard",
        "Match": { "Path": "/dashboard/{**catch-all}" }
      },
      "reporting-login": {
        "ClusterId": "dashboard",
        "Match": { "Path": "/login/{**catch-all}" }
      }
    },
    "Clusters": {
      "restaurant-operations": { "Destinations": { "primary": { "Address": "http://localhost:5112" } } },
      "dining": { "Destinations": { "primary": { "Address": "http://localhost:5102" } } },
      "catalog-read": { "Destinations": { "primary": { "Address": "http://localhost:5132" } } },
      "orders-read": { "Destinations": { "primary": { "Address": "http://localhost:5122" } } },
      "orders-write": { "Destinations": { "primary": { "Address": "http://localhost:5121" } } },
      "payments-write": { "Destinations": { "primary": { "Address": "http://localhost:5151" } } },
      "sales-read": { "Destinations": { "primary": { "Address": "http://localhost:5162" } } },
      "reporting": { "Destinations": { "primary": { "Address": "http://localhost:5142" } } },
      "dashboard": { "Destinations": { "primary": { "Address": "http://localhost:5600" } } }
    }
  }
}

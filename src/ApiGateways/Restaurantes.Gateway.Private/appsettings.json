{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "restaurant-operations-read": {
        "ClusterId": "restaurant-operations-read",
        "Match": {
          "Path": "/api/restaurant-operations/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "restaurant-operations-write": {
        "ClusterId": "restaurant-operations-write",
        "Match": {
          "Path": "/api/restaurant-operations/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      },
      "dining": {
        "ClusterId": "dining",
        "Match": { "Path": "/api/dining/{**catch-all}" }
      },
      "dining-hub": {
        "ClusterId": "dining",
        "Match": { "Path": "/hubs/dining/{**catch-all}" }
      },
      "catalog-read": {
        "ClusterId": "catalog-read",
        "Match": {
          "Path": "/api/catalog/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "catalog-write": {
        "ClusterId": "catalog-write",
        "Match": {
          "Path": "/api/catalog/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      },
      "orders-read": {
        "ClusterId": "orders-read",
        "Match": {
          "Path": "/api/orders/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "orders-write": {
        "ClusterId": "orders-write",
        "Match": {
          "Path": "/api/orders/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      },
      "cash-register": {
        "ClusterId": "cash-register",
        "Match": { "Path": "/api/cash-register/{**catch-all}" }
      },
      "payments-write": {
        "ClusterId": "payments-write",
        "Match": {
          "Path": "/api/payments/{**catch-all}",
          "Methods": [ "POST" ]
        }
      },
      "sales-read": {
        "ClusterId": "sales-read",
        "Match": {
          "Path": "/api/sales/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "orders-kds-hub": {
        "ClusterId": "orders-read",
        "Match": { "Path": "/hubs/kds/{**catch-all}" }
      },
      "kds-web": {
        "ClusterId": "kds-web",
        "Match": { "Path": "/kds/{**catch-all}" }
      },
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/identity/{**catch-all}" }
      },
      "integrations": {
        "ClusterId": "integrations",
        "Match": { "Path": "/api/integrations/{**catch-all}" }
      },
      "reporting": {
        "ClusterId": "reporting",
        "Match": { "Path": "/api/reporting/{**catch-all}" }
      },
      "reporting-hub": {
        "ClusterId": "reporting",
        "Match": { "Path": "/hubs/reporting/{**catch-all}" }
      }
    },
    "Clusters": {
      "kds-web": { "Destinations": { "primary": { "Address": "http://localhost:5700" } } },
      "restaurant-operations-read": { "Destinations": { "primary": { "Address": "http://localhost:5112" } } },
      "restaurant-operations-write": { "Destinations": { "primary": { "Address": "http://localhost:5111" } } },
      "dining": { "Destinations": { "primary": { "Address": "http://localhost:5102" } } },
      "catalog-read": { "Destinations": { "primary": { "Address": "http://localhost:5132" } } },
      "catalog-write": { "Destinations": { "primary": { "Address": "http://localhost:5131" } } },
      "orders-read": { "Destinations": { "primary": { "Address": "http://localhost:5122" } } },
      "orders-write": { "Destinations": { "primary": { "Address": "http://localhost:5121" } } },
      "cash-register": { "Destinations": { "primary": { "Address": "http://localhost:5105" } } },
      "payments-write": { "Destinations": { "primary": { "Address": "http://localhost:5151" } } },
      "sales-read": { "Destinations": { "primary": { "Address": "http://localhost:5162" } } },
      "identity": { "Destinations": { "primary": { "Address": "http://localhost:5106" } } },
      "integrations": { "Destinations": { "primary": { "Address": "http://localhost:5107" } } },
      "reporting": { "Destinations": { "primary": { "Address": "http://localhost:5142" } } }
    }
  }
}

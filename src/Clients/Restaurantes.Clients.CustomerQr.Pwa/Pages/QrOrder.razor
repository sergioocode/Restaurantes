@page "/{QrCode}"
@implements IAsyncDisposable
@inject CustomerQrApi Api
@inject IJSRuntime Js

<PageTitle>Tu pedido</PageTitle>

@if (loading)
{
    <section class="empty-page">
        <div class="spinner"></div>
        <h1>Cargando la carta…</h1>
        <p>Estamos comprobando el QR y cargando la carta.</p>
    </section>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <section class="empty-page error-page">
        <div class="brand-mark">!</div>
        <h1>No podemos completar la operación</h1>
        <p>@error</p>
        <button class="primary-button" @onclick="LoadAsync">Reintentar</button>
    </section>
}
else if (context is not null)
{
    @if (NeedsGuestCount)
    {
        <section class="guest-count">
            <label>¿Cuántos comensales van a comer?
                <input type="number" min="1" max="999" placeholder="Cantidad de comensales" @bind="guestCount" disabled="@busy" />
            </label>
            <p>Indica la cantidad antes de enviar el primer pedido.</p>
            @if (guestError is not null) { <p role="alert">@guestError</p> }
        </section>
    }
    else if (context.Session?.GuestCount is int savedGuestCount)
    {
        <p class="guest-count">Comensales: @savedGuestCount</p>
    }
    <header class="customer-header">
        <div>
            <span class="eyebrow">Pedido por QR</span>
            <h1>@context.Table.Label</h1>
            <p><strong>@restaurant?.Name</strong></p>
            <p>Local @context.Table.RestaurantId</p>
            <p>@context.Table.Code · @(context.Session is null ? "Consulta la carta" : "Sesión activa")</p>
        </div>
        <div class="table-badge">Mesa</div>
    </header>

    @if (!string.IsNullOrWhiteSpace(success))
    {
        <div class="success-banner">
            <strong>Pedido enviado a cocina</strong>
            <span>@success</span>
        </div>
    }

    @if (customerOrders.Count > 0)
    {
        <section class="customer-orders">
            <div class="section-heading">
                <h2>Tus pedidos</h2>
                <span>Se actualizan automáticamente</span>
            </div>
            <div class="customer-order-list">
                @foreach (OrderResponse order in customerOrders.OrderByDescending(x => x.CreatedAtUtc))
                {
                    OrderStatusText statusText = OrderProgress.CustomerText(order.Status);
                    <article class="customer-order-card @OrderProgress.CssClass(order.Status)">
                        <div>
                            <strong>Pedido @order.Id.ToString()[..8]</strong>
                            <small>@order.Total.ToString("0.00") €</small>
                        </div>
                        <div class="friendly-status">
                            <strong>@statusText.Title</strong>
                            <span>@statusText.Detail</span>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    @foreach (IGrouping<string, MenuItemResponse> category in Categories)
    {
        <section class="menu-section">
            <div class="section-heading">
                <h2>@category.Key</h2>
                <span>@category.Count() productos</span>
            </div>
            <div class="menu-grid">
                @foreach (MenuItemResponse product in category)
                {
                    int quantity = Quantity(product.ProductId);
                    <article class="product-card @(quantity > 0 ? "selected" : null)">
                        <div class="product-copy">
                            <span class="station">@product.PreparationStationName</span>
                            <h3>@product.ProductName</h3>
                            <strong>@product.Price.ToString("0.00") €</strong>
                        </div>
                        <div class="quantity-control">
                            <button disabled="@(quantity == 0 || busy)" @onclick="() => Change(product.ProductId, -1)">−</button>
                            <span>@quantity</span>
                            <button disabled="@busy" @onclick="() => Change(product.ProductId, 1)">+</button>
                        </div>
                        @if (quantity > 0)
                        {
                            <input
                                class="notes-input"
                                maxlength="500"
                                placeholder="Notas para cocina"
                                value="@Note(product.ProductId)"
                                @oninput="eventArgs => SetNote(product.ProductId, eventArgs.Value?.ToString())" />
                        }
                    </article>
                }
            </div>
        </section>
    }

    <aside class="checkout-bar">
        <div>
            <span>@ItemCount producto(s)</span>
            <strong>@Total.ToString("0.00") €</strong>
        </div>
        <button class="primary-button" disabled="@(busy || ItemCount == 0)" @onclick="SubmitOrderAsync">
            @(busy ? progress : context.QrRequiresImmediatePayment ? "Pagar online y enviar" : "Enviar pedido a cocina")
        </button>
    </aside>
}

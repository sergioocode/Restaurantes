<div class="restaurant-context">
    <label>
        <span>Local de trabajo</span>
        <select value="@Host.restaurantId" @onchange="Host.RestaurantChanged" disabled="@(Host.ContextRestaurants().Count == 0)">
            @foreach (RestaurantResponse restaurant in Host.ContextRestaurants())
            {
                <option value="@restaurant.Id">@restaurant.Name · @Home.RoleLabel(Host.CurrentRoleFor(restaurant.Id))</option>
            }
        </select>
    </label>
</div>

@code {
    [Parameter, EditorRequired]
    public Home Host { get; set; } = default!;
}

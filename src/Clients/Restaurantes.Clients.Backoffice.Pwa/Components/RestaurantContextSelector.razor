<div class="restaurant-context">
    <label>
        Local de trabajo
        <select value="@Host.restaurantId" @onchange="Host.RestaurantChanged" disabled="@(Host.SelectableRestaurants.Count == 0)">
            @foreach (RestaurantResponse restaurant in Host.SelectableRestaurants)
            {
                <option value="@restaurant.Id">@restaurant.Name · @Home.RoleLabel(Host.CurrentRoleFor(restaurant.Id))</option>
            }
        </select>
    </label>
</div>

@code {
    [Parameter, EditorRequired]
    public Home Host { get; set; } = default!;
}

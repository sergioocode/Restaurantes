@using Restaurantes.Clients.Backoffice.Pwa.Models
@inject Restaurantes.Clients.Backoffice.Pwa.Api.BackofficeApi Api

@if (!Host.HasGlobalPermission("catalog.global.manage")) { <NoAccessPanel /> }
else
{
    @if (!string.IsNullOrWhiteSpace(status)) { <p role="status">@status</p> }
    @if (snapshot is not null)
    {
        <details class="admin-panel" open><summary>Nuevo impuesto</summary>
            <div class="inline-form tax-create-form">
                <input aria-label="Código del nuevo impuesto" placeholder="Código" @bind="newTax.Code" />
                <input aria-label="Nombre del nuevo impuesto" placeholder="Impuesto" @bind="newTax.Name" />
                <label>Porcentaje<input type="number" min="0" max="100" step="0.0001" @bind="newTax.Rate" /></label>
                <button class="primary" @onclick="() => SaveTax(newTax, true)" disabled="@busy">Agregar Impuesto</button>
            </div>
        </details>
        <div class="maintenance-list">
            @foreach (CatalogTaxModel tax in snapshot.Taxes.OrderBy(x => x.Name))
            {
                <div class="maintenance-row @(tax.IsActive ? "" : "inactive")">
                    <input aria-label="Código de impuesto" @bind="tax.Code" />
                    <input aria-label="Nombre de impuesto" @bind="tax.Name" />
                    <label>Porcentaje<input type="number" min="0" max="100" step="0.0001" @bind="tax.Rate" /></label>
                    <label class="availability"><input type="checkbox" @bind="tax.IsActive" /> Activo</label>
                    <button class="primary" @onclick="() => SaveTax(tax, false)" disabled="@busy">Guardar</button>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public Home Host { get; set; } = default!;
    private CatalogDesignSnapshot? snapshot;
    private CatalogTaxModel newTax = new();
    private string? status;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        if (Host.HasGlobalPermission("catalog.global.manage")) await Refresh();
    }

    internal Task Refresh() => Run(async () => snapshot = await Api.CatalogDesignAsync(), false);

    private Task SaveTax(CatalogTaxModel tax, bool isNew) => Run(async () =>
    {
        await Api.SaveTaxAsync(tax);
        if (isNew) newTax = new();
        snapshot = await Api.CatalogDesignAsync();
    }, true);

    private async Task Run(Func<Task> action, bool saved)
    {
        busy = true;
        status = null;
        try
        {
            await action();
            if (saved) status = "Impuesto guardado.";
        }
        catch (Exception error)
        {
            status = error.Message;
        }
        finally
        {
            busy = false;
        }
    }
}

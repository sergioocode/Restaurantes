@if (!Host.CanManageUsers) { <NoAccessPanel /> }
else
{
    <details class="admin-panel" open>
        <summary>Autorizar cuenta</summary>
        <form class="inline-form user-create-form" @onsubmit="Host.CreateUser" @onsubmit:preventDefault>
            <input type="email" autocomplete="off" placeholder="Correo corporativo" @bind="Host.userDraft.Email" />
            <input placeholder="Nombre visible" @bind="Host.userDraft.DisplayName" />
            <select @bind="Host.userDraft.Role">
                @foreach (string role in Host.AssignableRoles)
                {
                    <option value="@role">@Home.RoleLabel(role)</option>
                }
            </select>
            <select @bind="Host.userDraft.RestaurantId">
                @if (Host.CanAssignAllRestaurants)
                {
                    <option value="">Todos los Locales</option>
                }
                @foreach (RestaurantResponse restaurant in Host.ManageableRestaurants)
                {
                    <option value="@restaurant.Id">@restaurant.Name</option>
                }
            </select>
            <button class="primary" disabled="@Host.busy">Autorizar</button>
        </form>
    </details>
    <div class="user-list">
        @foreach (StaffUserResponse user in Host.users.OrderBy(x => x.DisplayName))
        {
            <article class="user-card @(user.IsActive ? "" : "inactive")">
                <header>
                    <div><strong>@user.DisplayName</strong><small>@user.Email · @user.Provider · @(user.IsLinked ? "Vinculada" : "Pendiente de primer acceso")</small></div>
                </header>
                <div class="assignment-row">
                    <label>Nombre<input @bind="user.DisplayName" /></label>
                    <label>Rol<select @bind="user.Role">
                        @foreach (string role in Host.AssignableRoles)
                        {
                            <option value="@role">@Home.RoleLabel(role)</option>
                        }
                    </select></label>
                    <label>Local<select @bind="user.RestaurantId">
                        @if (Host.CanAssignAllRestaurants)
                        {
                            <option value="">Todos los Locales</option>
                        }
                        @foreach (RestaurantResponse restaurant in Host.ManageableRestaurants)
                        {
                            <option value="@restaurant.Id">@restaurant.Name</option>
                        }
                    </select></label>
                    <label class="availability"><input type="checkbox" @bind="user.IsActive" /> Activa</label>
                    <button class="primary" @onclick="() => Host.SaveUser(user)" disabled="@Host.busy">Guardar</button>
                </div>
            </article>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Home Host { get; set; } = default!;
}

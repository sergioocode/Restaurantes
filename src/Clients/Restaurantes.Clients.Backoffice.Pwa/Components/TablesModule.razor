<RestaurantContextSelector Host="Host" />
@if (!Host.HasLocalPermission("tables.manage")) { <NoAccessPanel /> }
else
{
    <div class="module-toolbar"><button class="secondary" @onclick="Host.RefreshModule" disabled="@Host.busy">Actualizar mesas</button></div>
    <details class="admin-panel" open><summary>Nueva ubicación</summary>
        <form class="inline-form" @onsubmit="Host.CreateTable" @onsubmit:preventDefault>
            <input placeholder="Código, ej. MESA-03" @bind="Host.tableDraft.Code" /><input placeholder="Nombre visible" @bind="Host.tableDraft.Label" />
            <select aria-label="Zona" @bind="Host.tableDraft.ZoneId"><option value="@Guid.Empty">Selecciona una zona</option>@foreach (ZoneResponse zone in Host.zones.OrderBy(x => x.SortOrder).ThenBy(x => x.Name)) { <option value="@zone.Id">@zone.Name</option> }</select>
            <label class="check-line"><input type="checkbox" @bind="Host.tableDraft.RequestGuestCount" /> Solicita cantidad de comensales antes de pedir</label>
            <button class="primary" disabled="@(Host.busy || Host.tableDraft.ZoneId == Guid.Empty)">Agregar</button>
        </form>
    </details>
    <div class="maintenance-list">
        @foreach (TableResponse item in Host.tables.OrderBy(x => x.Code))
        {
            <article class="table-maintenance @(item.IsActive ? "" : "inactive")">
                <div><strong>@item.Code</strong><small>@Home.StatusLabel(item.Status)</small></div>
                <label>Nombre<input @bind="item.Label" /></label>
                <label>Zona<select @bind="item.ZoneId">@foreach (ZoneResponse zone in Host.zones.OrderBy(x => x.SortOrder).ThenBy(x => x.Name)) { <option value="@zone.Id">@zone.Name</option> }</select></label>
                <label class="availability"><input type="checkbox" @bind="item.IsActive" disabled="@(item.Status == "Occupied")" /> Activa</label>
                <button class="primary" @onclick="() => Host.SaveTable(item)" disabled="@Host.busy">Guardar</button>
                <button class="secondary" @onclick="() => Host.DeleteTable(item)" disabled="@(Host.busy || item.Status == "Occupied")" title="Elimina la ubicación de la operación y conserva su historial">Eliminar</button>
                <label class="check-line guest-setting"><input type="checkbox" @bind="item.RequestGuestCount" /> Solicita cantidad de comensales antes de pedir</label>
                <div class="qr-data"><code>@item.QrCode</code><a href="@item.CustomerQrPath" target="_blank" rel="noopener noreferrer">Abrir QR</a><button class="secondary" @onclick="() => Host.RotateQr(item)" disabled="@(Host.busy || item.Status == "Occupied")">Regenerar QR</button></div>
            </article>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Home Host { get; set; } = default!;
}

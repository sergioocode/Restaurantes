@if (!Host.HasLocalPermission("tables.manage")) { <NoAccessPanel /> }
else
{
    <details class="admin-panel" open><summary>Nueva mesa</summary>
        <form class="inline-form" @onsubmit="Host.CreateTable" @onsubmit:preventDefault>
            <input placeholder="Código, ej. MESA-03" @bind="Host.tableDraft.Code" /><input placeholder="Nombre visible" @bind="Host.tableDraft.Label" />
            <select aria-label="Zona" @bind="Host.tableDraft.ZoneId"><option value="@Guid.Empty">Selecciona una zona</option>@foreach (ZoneResponse zone in Host.zones.OrderBy(x => x.SortOrder).ThenBy(x => x.Name)) { <option value="@zone.Id">@zone.Name</option> }</select>
            <button class="primary" disabled="@(Host.busy || Host.tableDraft.ZoneId == Guid.Empty)">Agregar Mesa</button>
        </form>
    </details>
    @foreach (IGrouping<Guid, TableResponse> group in Host.tables.GroupBy(x => x.ZoneId)
        .OrderBy(x => Host.zones.FirstOrDefault(zone => zone.Id == x.Key)?.SortOrder ?? int.MaxValue)
        .ThenBy(x => Host.zones.FirstOrDefault(zone => zone.Id == x.Key)?.Name ?? "Sin zona"))
    {
        <section class="table-zone-group">
            <h2>@(Host.zones.FirstOrDefault(zone => zone.Id == group.Key)?.Name ?? "Sin zona")</h2>
            <div class="maintenance-list">
                @foreach (TableResponse item in group.OrderBy(x => x.Code))
                {
                    <article class="table-maintenance @(item.IsActive ? "" : "inactive")">
                        <div class="table-code-status"><small>@Home.StatusLabel(item.Status)</small></div>
                        <div class="table-field-editor table-name-editor">
                            <label>Nombre<input @bind="drafts[item.Id].Label" /></label>
                            <button class="primary product-name-save" @onclick="() => SaveLabel(item)" disabled="@Host.busy" aria-label="Guardar nombre de mesa" title="Guardar nombre">
                                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                    <path d="M4 3h13l3 3v15H4z" />
                                    <path d="M7 3v6h10V3M7 21v-8h10v8M14 3v4" />
                                </svg>
                            </button>
                        </div>
                        <div class="table-field-editor table-zone-editor">
                            <select aria-label="Zona" value="@item.ZoneId" @onchange="args => SetZone(item, args)" disabled="@Host.busy">
                                @foreach (ZoneResponse zone in Host.zones.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
                                {
                                    <option value="@zone.Id">@zone.Name</option>
                                }
                            </select>
                        </div>
                        <label class="availability table-active"><input type="checkbox" checked="@item.IsActive" @onchange="args => SetActive(item, args)" disabled="@(Host.busy || item.Status == "Occupied")" /> Activa</label>
                        <div class="table-qr-data"><code title="@item.QrCode">@item.QrCode</code><a href="@item.CustomerQrPath" target="_blank" rel="noopener noreferrer">Abrir QR</a></div>
                        <button class="secondary table-qr-button" @onclick="() => Host.RotateQr(item)" disabled="@(Host.busy || item.Status == "Occupied")">Regenerar QR</button>
                        <button class="danger table-delete-button" @onclick="() => Host.DeleteTable(item)" disabled="@(Host.busy || item.Status == "Occupied")" title="Solo se pueden eliminar mesas sin ventas y sin sesión abierta">Eliminar</button>
                    </article>
                }
            </div>
        </section>
    }
}

@code {
    [Parameter, EditorRequired]
    public Home Host { get; set; } = default!;

    private readonly Dictionary<Guid, TableEditDraft> drafts = [];

    protected override void OnParametersSet()
    {
        foreach (TableResponse table in Host.tables)
        {
            if (!drafts.TryGetValue(table.Id, out TableEditDraft? draft) || !ReferenceEquals(draft.Source, table))
            {
                drafts[table.Id] = new TableEditDraft(table);
            }
        }
    }

    private Task SaveLabel(TableResponse table) => Host.SaveTableLabel(table, drafts[table.Id].Label);

    private Task SetZone(TableResponse table, ChangeEventArgs args) =>
        args.Value is string value && Guid.TryParse(value, out Guid zoneId)
            ? Host.SaveTableZone(table, zoneId)
            : Task.CompletedTask;

    private async Task SetActive(TableResponse table, ChangeEventArgs args)
    {
        bool previous = table.IsActive;
        bool selected = args.Value is bool value && value;
        table.IsActive = selected;
        if (!await Host.SetTableActive(table, selected))
        {
            table.IsActive = previous;
        }
    }

    private sealed class TableEditDraft(TableResponse table)
    {
        public TableResponse Source { get; } = table;
        public string Label { get; set; } = table.Label;
    }
}

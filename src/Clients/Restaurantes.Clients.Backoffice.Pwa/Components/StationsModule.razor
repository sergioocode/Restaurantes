@if (!Host.IsCurrentRestaurantManager) { <NoAccessPanel /> }
else
{
    <details class="admin-panel" open><summary>Nueva estación KDS</summary>
        <form class="inline-form station-create-form" @onsubmit="Host.CreateStation" @onsubmit:preventDefault>
            <input placeholder="Código, ej. PIZZA" @bind="Host.stationDraft.Code" />
            <input placeholder="Nombre visible, ej. Horno de pizzas" @bind="Host.stationDraft.Name" />
            <label class="station-priority-field">Prioridad<input type="number" min="0" max="99" @bind="Host.stationDraft.Priority" disabled="@Host.stationDraft.IsPrimary" /></label>
            <label class="availability"><input type="checkbox" @bind="Host.stationDraft.IsPrimary" /> KDS principal</label>
            <label class="availability"><input type="checkbox" @bind="Host.stationDraft.RequiresPrimaryDispatch" disabled="@Host.stationDraft.IsPrimary" /> Requiere despacho del principal</label>
            <button class="primary" disabled="@Host.busy">Agregar</button>
        </form>
    </details>
    <div class="maintenance-list">
        @foreach (KitchenStationResponse item in Host.stations.OrderBy(x => x.Priority).ThenBy(x => x.Name))
        {
            <article class="maintenance-row station-row @(item.IsActive ? "" : "inactive")">
                <div><strong>@item.Code</strong></div>
                <div class="station-field-editor">
                    <label>Nombre KDS<input maxlength="80" @bind="textDrafts[item.Id].Name" /></label>
                    <button class="primary product-name-save" @onclick="() => SaveName(item)" disabled="@Host.busy" aria-label="Guardar nombre KDS" title="Guardar nombre KDS">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                            <path d="M4 3h13l3 3v15H4z" />
                            <path d="M7 3v6h10V3M7 21v-8h10v8M14 3v4" />
                        </svg>
                    </button>
                </div>
                <div class="station-field-editor">
                    <label>Prioridad<input type="number" min="1" max="99" @bind="textDrafts[item.Id].Priority" disabled="@(Host.busy || item.IsPrimary)" /></label>
                    <button class="primary product-name-save" @onclick="() => SavePriority(item)" disabled="@(Host.busy || item.IsPrimary)" aria-label="Guardar prioridad KDS" title="Guardar prioridad KDS">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                            <path d="M4 3h13l3 3v15H4z" />
                            <path d="M7 3v6h10V3M7 21v-8h10v8M14 3v4" />
                        </svg>
                    </button>
                </div>
                <label class="availability"><input type="checkbox" checked="@item.IsPrimary" @onchange='args => Toggle(item, "IsPrimary", args)' disabled="@Host.busy" /> Principal</label>
                <label class="availability"><input type="checkbox" checked="@item.RequiresPrimaryDispatch" @onchange='args => Toggle(item, "RequiresPrimaryDispatch", args)' disabled="@(Host.busy || item.IsPrimary)" /> Despacha principal</label>
                <label class="availability"><input type="checkbox" checked="@item.IsActive" @onchange='args => Toggle(item, "IsActive", args)' disabled="@Host.busy" /> Activa</label>
            </article>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Home Host { get; set; } = default!;

    private readonly Dictionary<Guid, StationTextDraft> textDrafts = [];

    protected override void OnParametersSet()
    {
        foreach (KitchenStationResponse station in Host.stations)
        {
            if (
                !textDrafts.TryGetValue(station.Id, out StationTextDraft? draft)
                || !ReferenceEquals(draft.Source, station)
            )
            {
                textDrafts[station.Id] = new StationTextDraft(station);
            }
        }
    }

    private async Task SaveName(KitchenStationResponse station)
    {
        StationTextDraft draft = textDrafts[station.Id];
        if (await Host.SaveStationName(station, draft.Name))
        {
            draft.Name = station.Name;
        }
    }

    private async Task SavePriority(KitchenStationResponse station)
    {
        StationTextDraft draft = textDrafts[station.Id];
        if (await Host.SaveStationPriority(station, draft.Priority))
        {
            draft.Priority = station.Priority;
        }
    }

    private async Task Toggle(KitchenStationResponse station, string field, ChangeEventArgs args)
    {
        await Host.SetStationFlag(station, field, args.Value is bool selected && selected);
        if (field == nameof(KitchenStationResponse.IsPrimary))
        {
            textDrafts[station.Id].Priority = station.Priority;
        }
    }

    private sealed class StationTextDraft(KitchenStationResponse station)
    {
        public KitchenStationResponse Source { get; } = station;
        public string Name { get; set; } = station.Name;
        public int Priority { get; set; } = station.Priority;
    }
}

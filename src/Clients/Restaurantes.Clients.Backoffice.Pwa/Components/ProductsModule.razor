@using Restaurantes.Clients.Backoffice.Pwa.Models
@inject Restaurantes.Clients.Backoffice.Pwa.Api.BackofficeApi Api

@if (!Host.HasGlobalPermission("catalog.global.manage"))
{
    <NoAccessPanel />
}
else
{
    <div class="module-toolbar"><button class="secondary" @onclick="Host.RefreshModule" disabled="@Host.busy">Recargar</button></div>
    <details class="admin-panel" open>
        <summary>Nuevo producto</summary>
        <form class="inline-form" @onsubmit="Host.CreateProduct" @onsubmit:preventDefault>
            <input placeholder="SKU" @bind="Host.productDraft.Sku" /><input placeholder="Nombre" @bind="Host.productDraft.Name" />
            <select @bind="Host.productDraft.CategoryId"><option value="@Guid.Empty">Categoría</option>@foreach (CategoryResponse category in Host.categories.Where(x => x.IsActive)) {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
        <button class="primary" disabled="@Host.busy">Agregar</button>
    </form>
</details>
<div class="maintenance-list">
    @foreach (IGrouping<Guid, ProductResponse> group in Host.products
        .GroupBy(x => x.CategoryId)
        .OrderBy(x => Host.categories.FirstOrDefault(c => c.Id == x.Key)?.Name ?? "Sin categoría"))
    {
        <section class="product-category-group">
            <h2>@(Host.categories.FirstOrDefault(c => c.Id == group.Key)?.Name ?? "Sin categoría")</h2>
            @foreach (ProductResponse item in group.OrderBy(x => x.Name))
            {
                <article class="maintenance-row product-maintenance @(item.IsActive ? "" : "inactive")">
                    <div>
                        @if (snapshot?.ProductPhotos.FirstOrDefault(x => x.ProductId == item.Id) is { } photo)
                        {
                            <img class="product-thumb" src="@($"/api/catalog/products/{item.Id}/photos/small?v={photo.Revision}")" alt="" loading="lazy" width="64" height="64" />
                        }
                        <strong>@item.Sku</strong><small>v@item.Version</small>
                    </div>
                    <label>Nombre<input @bind="item.Name" /></label>
                    <label>Categoría<select @bind="item.CategoryId">@foreach (CategoryResponse category in Host.categories) {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select></label>
                    <label class="availability"><input type="checkbox" @bind="item.IsActive" /> Activo</label>
                    @if (snapshot is not null)
                    {
                        <ProductSettings Product="item" Host="Host" Snapshot="snapshot" OnSaved="RefreshSettings" />
                    }
                    <button class="primary" @onclick="() => Host.SaveProduct(item)" disabled="@Host.busy">Guardar</button>
                </article>
            }
        </section>
}
</div>
}

@code {
    [Parameter, EditorRequired]
    public Home Host { get; set; } = default!;
    private CatalogDesignSnapshot? snapshot;
    protected override async Task OnInitializedAsync() => await RefreshSettings();
    private async Task RefreshSettings() => snapshot = await Api.CatalogDesignAsync();
}

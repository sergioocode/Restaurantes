@page "/"
@using System.Text.Json
@inject BackofficeApi Api
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject Restaurantes.Clients.Backoffice.Pwa.Security.SessionAuthenticationStateProvider AuthState

<PageTitle>Backoffice · Restaurantes</PageTitle>

@if (initializing)
{
    <main class="loading">Cargando Backoffice…</main>
}
else if (login is null)
{
    <main class="login-shell">
        <section class="login-card">
            <span class="brand">R</span><p class="eyebrow">ADMINISTRACIÓN</p><h1>Backoffice</h1>
            <p>Configuración central y por local.</p>
            <div class="login-providers">
                <button class="primary" type="button" @onclick='() => StartLogin("Microsoft")'
                        disabled="@(providerSettings is null || providerSettings.ActiveProvider != "Microsoft" || !MicrosoftConfigured)">
                    Iniciar sesión con Microsoft
                </button>
                <button class="primary" type="button" @onclick='() => StartLogin("Google")'
                        disabled="@(providerSettings is null || providerSettings.ActiveProvider != "Google" || !GoogleConfigured)">
                    Iniciar sesión con Google
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(message)) { <p class="error">@message</p> }
        </section>
    </main>
}
else
{
    <header class="topbar">
        <div><p class="eyebrow">RESTAURANTES · BACKOFFICE</p><strong>@login.User.DisplayName</strong></div>
        <div class="top-actions">
            <select value="@restaurantId" @onchange="RestaurantChanged">
                @foreach (RestaurantResponse restaurant in SelectableRestaurants)
                {
                    <option value="@restaurant.Id">@restaurant.Name · @RoleLabel(CurrentRoleFor(restaurant.Id))</option>
                }
            </select>
            <button class="secondary" @onclick="LoadAll" disabled="@busy">Actualizar</button>
            <button class="secondary" @onclick="Logout">Salir</button>
        </div>
    </header>

    <main class="workspace">
        <aside class="sidebar">
            <h2>Módulos</h2>
            @if (HasLocalPermission("catalog.manage")) { <button class="@NavClass("menu")" @onclick='() => module = "menu"'>Menú por local</button> }
            @if (HasLocalPermission("kds.use")) { <button class="@NavClass("stations")" @onclick='() => module = "stations"'>Estaciones KDS</button> }
            @if (HasLocalPermission("tables.read")) { <button class="@NavClass("tables")" @onclick='() => module = "tables"'>Mesas y configuración</button> }
            @if (IsAdmin) { <button class="@NavClass("restaurants")" @onclick='() => module = "restaurants"'>Locales</button> }
            @if (IsAdmin) { <button class="@NavClass("categories")" @onclick='() => module = "categories"'>Categorías</button> }
            @if (IsAdmin) { <button class="@NavClass("products")" @onclick='() => module = "products"'>Productos</button> }
            @if (HasLocalPermission("reports.financial.read")) { <button disabled>Contabilidad <small>Próximo</small></button> }
            @if (HasLocalPermission("reports.marketing.read")) { <button disabled>Marketing y KPI <small>Próximo</small></button> }
            @if (HasLocalPermission("reports.kitchen.read")) { <button disabled>Tiempos de cocina <small>Próximo</small></button> }
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <button class="@NavClass("users")" @onclick='() => module = "users"'>Usuarios y perfiles</button>
                </Authorized>
            </AuthorizeView>
        </aside>

        <section class="content">
            <div class="page-title">
                <div><p class="eyebrow">@ModuleEyebrow</p><h1>@ModuleTitle</h1></div>
                <span class="role-chip">@RoleLabel(CurrentRoleFor(restaurantId))</span>
            </div>

            @if (module == "menu")
            {
                <MenuModule Host="this" />
            }
            else if (module == "stations")
            {
                <StationsModule Host="this" />
            }
            else if (module == "categories")
            {
                <CategoriesModule Host="this" />
            }
            else if (module == "products")
            {
                <ProductsModule Host="this" />
            }
            else if (module == "restaurants")
            {
                <RestaurantsModule Host="this" />
            }
            else if (module == "users")
            {
                <UsersModule Host="this" />
            }
            else if (module == "tables")
            {
                <TablesModule Host="this" />
            }
        </section>
    </main>
    @if (!string.IsNullOrWhiteSpace(message)) { <div class="toast @(ok ? "ok" : "error")">@message</div> }
}

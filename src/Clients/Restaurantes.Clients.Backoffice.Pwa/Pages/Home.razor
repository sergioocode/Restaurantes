@page "/"
@using System.Text.Json
@inject BackofficeApi Api
@inject IJSRuntime Js

<PageTitle>Backoffice · Restaurantes</PageTitle>

@if (login is null)
{
    <main class="login-shell">
        <section class="login-card">
            <span class="brand">R</span><p class="eyebrow">ADMINISTRACIÓN</p><h1>Backoffice</h1>
            <p>Configuración central y por local.</p>
            <form @onsubmit="Login" @onsubmit:preventDefault>
                <label>Usuario<input autocomplete="username" @bind="username" /></label>
                <label>Contraseña<input type="password" autocomplete="current-password" @bind="password" /></label>
                <button class="primary" disabled="@busy">@(busy ? "Entrando…" : "Entrar")</button>
            </form>
            <small>Desarrollo: admin / Admin-2026!</small>
            @if (!string.IsNullOrWhiteSpace(message)) { <p class="error">@message</p> }
        </section>
    </main>
}
else
{
    <header class="topbar">
        <div><p class="eyebrow">RESTAURANTES · BACKOFFICE</p><strong>@login.User.DisplayName</strong></div>
        <div class="top-actions">
            <select value="@restaurantId" @onchange="RestaurantChanged">
                @foreach (RestaurantResponse restaurant in SelectableRestaurants)
                {
                    <option value="@restaurant.Id">@restaurant.Name · @RoleLabel(CurrentRoleFor(restaurant.Id))</option>
                }
            </select>
            <button class="secondary" @onclick="LoadAll" disabled="@busy">Actualizar</button>
            <button class="secondary" @onclick="Logout">Salir</button>
        </div>
    </header>

    <main class="workspace">
        <aside class="sidebar">
            <h2>Módulos</h2>
            <button class="@NavClass("menu")" @onclick='() => module = "menu"'>Menú por local</button>
            <button class="@NavClass("stations")" @onclick='() => module = "stations"'>Estaciones KDS</button>
            <button class="@NavClass("tables")" @onclick='() => module = "tables"'>Mesas y configuración</button>
            <button class="@NavClass("restaurants")" @onclick='() => module = "restaurants"'>Locales</button>
            <button class="@NavClass("categories")" @onclick='() => module = "categories"'>Categorías</button>
            <button class="@NavClass("products")" @onclick='() => module = "products"'>Productos</button>
            @if (HasLocalPermission("reports.financial.read")) { <button disabled>Contabilidad <small>Próximo</small></button> }
            @if (HasLocalPermission("reports.marketing.read")) { <button disabled>Marketing y KPI <small>Próximo</small></button> }
            @if (HasLocalPermission("reports.kitchen.read")) { <button disabled>Tiempos de cocina <small>Próximo</small></button> }
            @if (CanManageUsers) { <button class="@NavClass("users")" @onclick='() => module = "users"'>Usuarios y perfiles</button> }
        </aside>

        <section class="content">
            <div class="page-title">
                <div><p class="eyebrow">@ModuleEyebrow</p><h1>@ModuleTitle</h1></div>
                <span class="role-chip">@RoleLabel(CurrentRoleFor(restaurantId))</span>
            </div>

            @if (module == "menu")
            {
                @if (!HasLocalPermission("catalog.manage")) { <NoAccessPanel /> }
                else
                {
                    <div class="catalog-toolbar"><input type="search" placeholder="Buscar producto o SKU" @bind="search" @bind:event="oninput" /><span>@VisibleProducts.Count producto(s)</span></div>
                    <div class="product-list">
                        @foreach (ProductResponse product in VisibleProducts)
                        {
                            CategoryResponse? category = categories.FirstOrDefault(x => x.Id == product.CategoryId);
                            MenuEditor editor = editors[product.Id];
                            <article class="product-row @(product.IsActive ? "" : "inactive")">
                                <div class="product-name"><span>@category?.Name</span><strong>@product.Name</strong><small>@product.Sku · Base @product.BasePrice.ToString("0.00") €</small></div>
                                <label>Precio<input type="number" min="0" step="0.01" @bind="editor.Price" /></label>
                                <label>Estación KDS<select value="@editor.PreparationStationCode" @onchange="args => SelectStation(editor, args)">@foreach (KitchenStationResponse station in stations.Where(x => (!x.IsPrimary && x.IsActive) || x.Code == editor.PreparationStationCode)) { <option value="@station.Code">@station.Name</option> }</select></label>
                                <label class="availability"><input type="checkbox" @bind="editor.IsAvailable" disabled="@(!product.IsActive)" /> Visible</label>
                                <button class="primary" @onclick="() => SaveMenuItem(product)" disabled="@(busy || !product.IsActive)">Guardar</button>
                            </article>
                        }
                    </div>
                }
            }
            else if (module == "stations")
            {
                @if (!HasLocalPermission("catalog.manage")) { <NoAccessPanel /> }
                else
                {
                    <details class="admin-panel" open><summary>Nueva estación KDS</summary>
                        <form class="inline-form" @onsubmit="CreateStation" @onsubmit:preventDefault>
                            <input placeholder="Código, ej. PIZZA" @bind="stationDraft.Code" />
                            <input placeholder="Nombre visible, ej. Horno de pizzas" @bind="stationDraft.Name" />
                            <label>Prioridad<input type="number" min="0" max="99" @bind="stationDraft.Priority" disabled="@stationDraft.IsPrimary" /></label>
                            <label class="availability"><input type="checkbox" @bind="stationDraft.IsPrimary" /> KDS principal</label>
                            <label class="availability"><input type="checkbox" @bind="stationDraft.RequiresPrimaryDispatch" disabled="@stationDraft.IsPrimary" /> Requiere despacho del principal</label>
                            <button class="primary" disabled="@busy">Agregar</button>
                        </form>
                    </details>
                    <div class="maintenance-list">
                        @foreach (KitchenStationResponse item in stations.OrderBy(x => x.Priority).ThenBy(x => x.Name))
                        {
                            <article class="maintenance-row @(item.IsActive ? "" : "inactive")">
                                <div><strong>@item.Code</strong><small>v@item.Version</small></div>
                                <label>Nombre KDS<input maxlength="80" @bind="item.Name" /></label>
                                <label>Prioridad<input type="number" min="0" max="99" @bind="item.Priority" disabled="@item.IsPrimary" /></label>
                                <label class="availability"><input type="checkbox" @bind="item.IsPrimary" /> Principal</label>
                                <label class="availability"><input type="checkbox" @bind="item.RequiresPrimaryDispatch" disabled="@item.IsPrimary" /> Despacha principal</label>
                                <label class="availability"><input type="checkbox" @bind="item.IsActive" /> Activa</label>
                                <button class="primary" @onclick="() => SaveStation(item)" disabled="@busy">Guardar</button>
                            </article>
                        }
                    </div>
                }
            }
            else if (module == "categories")
            {
                @if (!HasGlobalPermission("catalog.global.manage")) { <NoAccessPanel /> }
                else
                {
                    <details class="admin-panel" open><summary>Nueva categoría</summary>
                        <form class="inline-form" @onsubmit="CreateCategory" @onsubmit:preventDefault>
                            <input placeholder="Código" @bind="categoryDraft.Code" /><input placeholder="Nombre" @bind="categoryDraft.Name" />
                            <select value="@categoryDraft.DefaultStationCode" @onchange="SelectDraftCategoryStation" disabled="@(stations.Count(x => x.IsActive) == 0)">
                                <option value="">Estación KDS</option>
                                @foreach (KitchenStationResponse station in stations.Where(x => x.IsActive && !x.IsPrimary).OrderBy(x => x.Name))
                                {
                                    <option value="@station.Code">@station.Name</option>
                                }
                            </select>
                            <button class="primary" disabled="@busy">Agregar</button>
                        </form>
                    </details>
                    <div class="maintenance-list">
                        @foreach (CategoryResponse item in categories.OrderBy(x => x.Name))
                        {
                            <article class="maintenance-row @(item.IsActive ? "" : "inactive")">
                                <div><strong>@item.Code</strong><small>v@item.Version</small></div>
                                <label>Nombre<input @bind="item.Name" /></label>
                                <label>Estación KDS<select value="@item.DefaultStationCode" @onchange="args => SelectCategoryStation(item, args)">
                                    @if (!stations.Any(x => x.Code == item.DefaultStationCode))
                                    {
                                        <option value="@item.DefaultStationCode">@item.DefaultStationName (no disponible en este local)</option>
                                    }
                                    @foreach (KitchenStationResponse station in stations.Where(x => (!x.IsPrimary && x.IsActive) || x.Code == item.DefaultStationCode).OrderBy(x => x.Name))
                                    {
                                        <option value="@station.Code">@station.Name</option>
                                    }
                                </select></label>
                                <label class="availability"><input type="checkbox" @bind="item.IsActive" /> Activa</label>
                                <button class="primary" @onclick="() => SaveCategory(item)" disabled="@busy">Guardar</button>
                            </article>
                        }
                    </div>
                }
            }
            else if (module == "products")
            {
                @if (!HasGlobalPermission("catalog.global.manage")) { <NoAccessPanel /> }
                else
                {
                    <details class="admin-panel" open><summary>Nuevo producto</summary>
                        <form class="inline-form" @onsubmit="CreateProduct" @onsubmit:preventDefault>
                            <input placeholder="SKU" @bind="productDraft.Sku" /><input placeholder="Nombre" @bind="productDraft.Name" />
                            <select @bind="productDraft.CategoryId"><option value="@Guid.Empty">Categoría</option>@foreach (CategoryResponse category in categories.Where(x => x.IsActive)) { <option value="@category.Id">@category.Name</option> }</select>
                            <input type="number" min="0" step="0.01" @bind="productDraft.BasePrice" /><button class="primary" disabled="@busy">Agregar</button>
                        </form>
                    </details>
                    <div class="maintenance-list">
                        @foreach (ProductResponse item in products.OrderBy(x => x.Name))
                        {
                            <article class="maintenance-row product-maintenance @(item.IsActive ? "" : "inactive")">
                                <div><strong>@item.Sku</strong><small>v@item.Version</small></div><label>Nombre<input @bind="item.Name" /></label>
                                <label>Categoría<select @bind="item.CategoryId">@foreach (CategoryResponse category in categories) { <option value="@category.Id">@category.Name</option> }</select></label>
                                <label>Precio base<input type="number" min="0" step="0.01" @bind="item.BasePrice" /></label>
                                <label class="availability"><input type="checkbox" @bind="item.IsActive" /> Activo</label><button class="primary" @onclick="() => SaveProduct(item)" disabled="@busy">Guardar</button>
                            </article>
                        }
                    </div>
                }
            }
            else if (module == "restaurants")
            {
                @if (IsAdmin)
                {
                    <details class="admin-panel"><summary>Nuevo local · solo Admin</summary>
                        <form class="inline-form" @onsubmit="CreateRestaurant" @onsubmit:preventDefault>
                            <input placeholder="Código" @bind="restaurantDraft.Code" /><input placeholder="Nombre" @bind="restaurantDraft.Name" />
                            <input class="wide" placeholder="Dirección" @bind="restaurantDraft.Address" /><button class="primary" disabled="@busy">Agregar</button>
                        </form>
                    </details>
                }
                @if (CurrentRestaurant is not null)
                {
                    <section class="settings-panel">
                        <div><strong>@CurrentRestaurant.Code</strong><small>ID @CurrentRestaurant.Id</small></div>
                        <label>Nombre<input @bind="CurrentRestaurant.Name" /></label><label>Dirección<input @bind="CurrentRestaurant.Address" /></label>
                        <label class="availability"><input type="checkbox" @bind="CurrentRestaurant.IsActive" /> Local activo</label>
                        <button class="primary" @onclick="SaveRestaurant" disabled="@busy">Guardar local</button>
                    </section>
                }
            }
            else if (module == "users")
            {
                @if (!CanManageUsers) { <NoAccessPanel /> }
                else
                {
                    <details class="admin-panel" open><summary>Nuevo usuario</summary>
                        <form class="inline-form user-create-form" @onsubmit="CreateUser" @onsubmit:preventDefault>
                            <input autocomplete="off" placeholder="Usuario" @bind="userDraft.Username" />
                            <input placeholder="Nombre visible" @bind="userDraft.DisplayName" />
                            <input type="password" autocomplete="new-password" placeholder="Contraseña (mín. 10)" @bind="userDraft.Password" />
                            <select @bind="userDraft.RestaurantId"><option value="@Guid.Empty">Local inicial</option>@foreach (RestaurantResponse restaurant in ManageableRestaurants) { <option value="@restaurant.Id">@restaurant.Name · @restaurant.Id</option> }</select>
                            <select @bind="userDraft.Role">@foreach (string role in AssignableRoles) { <option value="@role">@RoleLabel(role)</option> }</select>
                            <button class="primary" disabled="@busy">Crear</button>
                        </form>
                    </details>
                    <div class="user-list">
                        @foreach (StaffUserResponse user in users.OrderBy(x => x.DisplayName))
                        {
                            <article class="user-card @(user.IsActive ? "" : "inactive")">
                                <header><div><strong>@user.DisplayName</strong><small>@user.Username · ID @user.Id</small></div><span>@(user.IsActive ? "Activo" : "Inactivo")</span></header>
                                <div class="assignment-list">
                                    @foreach (UserRestaurantAssignmentResponse assignment in user.Restaurants.OrderBy(x => RestaurantName(x.RestaurantId)))
                                    {
                                        <div class="assignment-row">
                                            <label>Local<input value="@RestaurantNameWithId(assignment.RestaurantId)" readonly /></label>
                                            <label>Rol<select @bind="assignment.Role">@foreach (string role in AssignableRolesFor(assignment.Role)) { <option value="@role">@RoleLabel(role)</option> }</select></label>
                                            <label>Desde<input type="date" value="@DateValue(assignment.ValidFromUtc)" @onchange="e => assignment.ValidFromUtc = ParseDate(e.Value)" /></label>
                                            <label>Hasta<input type="date" value="@DateValue(assignment.ValidUntilUtc)" @onchange="e => assignment.ValidUntilUtc = ParseDate(e.Value)" /></label>
                                            <label class="availability"><input type="checkbox" @bind="assignment.IsActive" /> Activa</label>
                                            <button class="primary" @onclick="() => SaveAssignment(user, assignment)" disabled="@busy">Guardar</button>
                                        </div>
                                    }
                                </div>
                                <form class="assignment-add" @onsubmit="() => AddAssignment(user)" @onsubmit:preventDefault>
                                    <select @bind="assignmentDrafts[user.Id].RestaurantId"><option value="@Guid.Empty">Añadir otro local</option>@foreach (RestaurantResponse restaurant in AvailableRestaurantsFor(user)) { <option value="@restaurant.Id">@restaurant.Name · @restaurant.Id</option> }</select>
                                    <select @bind="assignmentDrafts[user.Id].Role">@foreach (string role in AssignableRoles) { <option value="@role">@RoleLabel(role)</option> }</select>
                                    <button class="secondary" disabled="@busy">Asignar local</button>
                                </form>
                            </article>
                        }
                    </div>
                }
            }
            else if (module == "tables")
            {
                @if (!HasLocalPermission("tables.manage")) { <NoAccessPanel /> }
                else
                {
                    <section class="settings-panel policy-panel">
                        <h2>Política del local</h2>
                        <label class="check-line"><input type="checkbox" @bind="policy.QrRequiresImmediatePayment" /> El cliente QR paga antes de enviar a cocina</label>
                        <label class="check-line"><input type="checkbox" @bind="policy.TakeawayRequiresPrepayment" /> Para llevar requiere cobro previo</label>
                        <label class="check-line"><input type="checkbox" @bind="policy.AllowCheckoutBeforeKitchenCompletion" /> Permite cobrar antes de terminar los KDS</label>
                        <label class="check-line"><input type="checkbox" @bind="policy.RequireTrustedNetworkForQr" /> Exigir red autorizada para usar QR</label>
                        <label>IP o redes CIDR autorizadas, una por línea<textarea rows="3" @bind="allowedNetworksText"></textarea></label>
                        <button class="primary" @onclick="SavePolicy" disabled="@busy">Guardar política</button>
                    </section>
                    <section class="admin-panel">
                        <h3>Zonas del restaurante</h3>
                        <form class="inline-form" @onsubmit="CreateZone" @onsubmit:preventDefault>
                            <input aria-label="Nombre de la zona" placeholder="Nueva zona, ej. Terraza" maxlength="80" required @bind="zoneDraft.Name" />
                            <input aria-label="Orden de la zona" type="number" min="0" @bind="zoneDraft.SortOrder" />
                            <button class="primary" disabled="@busy">Agregar zona</button>
                        </form>
                        @if (zones.Count == 0) { <p>Crea una zona antes de agregar mesas o puestos de barra.</p> }
                        @foreach (ZoneResponse zone in zones.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
                        {
                            <div class="inline-form" @key="zone.Id">
                                <label>Zona<input maxlength="80" @bind="zone.Name" /></label>
                                <label>Orden<input type="number" min="0" @bind="zone.SortOrder" /></label>
                                <span>@tables.Count(x => x.ZoneId == zone.Id) ubicaciones</span>
                                <button class="primary" @onclick="() => SaveZone(zone)" disabled="@busy">Guardar zona</button>
                                <button class="secondary" @onclick="() => DeleteZone(zone)" disabled="@(busy || tables.Any(x => x.ZoneId == zone.Id))">Eliminar zona vacía</button>
                            </div>
                        }
                    </section>
                    <details class="admin-panel" open><summary>Nueva ubicación</summary>
                        <form class="inline-form" @onsubmit="CreateTable" @onsubmit:preventDefault>
                            <input placeholder="Código, ej. MESA-03" @bind="tableDraft.Code" /><input placeholder="Nombre visible" @bind="tableDraft.Label" />
                            <select aria-label="Zona" @bind="tableDraft.ZoneId"><option value="@Guid.Empty">Selecciona una zona</option>@foreach (ZoneResponse zone in zones.OrderBy(x => x.SortOrder).ThenBy(x => x.Name)) { <option value="@zone.Id">@zone.Name</option> }</select>
                            <label class="check-line"><input type="checkbox" @bind="tableDraft.RequestGuestCount" /> Solicita cantidad de comensales antes de pedir</label>
                            <button class="primary" disabled="@(busy || tableDraft.ZoneId == Guid.Empty)">Agregar</button>
                        </form>
                    </details>
                    <div class="maintenance-list">
                        @foreach (TableResponse item in tables.OrderBy(x => x.Code))
                        {
                            <article class="table-maintenance @(item.IsActive ? "" : "inactive")">
                                <div><strong>@item.Code</strong><small>@StatusLabel(item.Status)</small></div>
                                <label>Nombre<input @bind="item.Label" /></label>
                                <label>Zona<select @bind="item.ZoneId">@foreach (ZoneResponse zone in zones.OrderBy(x => x.SortOrder).ThenBy(x => x.Name)) { <option value="@zone.Id">@zone.Name</option> }</select></label>
                                <label class="availability"><input type="checkbox" @bind="item.IsActive" disabled="@(item.Status == "Occupied")" /> Activa</label>
                                <button class="primary" @onclick="() => SaveTable(item)" disabled="@busy">Guardar</button>
                                <button class="secondary" @onclick="() => DeleteTable(item)" disabled="@(busy || item.Status == "Occupied")" title="Elimina la ubicación de la operación y conserva su historial">Eliminar</button>
                                <label class="check-line guest-setting"><input type="checkbox" @bind="item.RequestGuestCount" /> Solicita cantidad de comensales antes de pedir</label>
                                <div class="qr-data"><code>@item.QrCode</code><a href="@($"http://localhost:5300{item.CustomerQrPath}")" target="_blank" rel="noopener noreferrer">Abrir QR</a><button class="secondary" @onclick="() => RotateQr(item)" disabled="@(busy || item.Status == "Occupied")">Regenerar QR</button></div>
                            </article>
                        }
                    </div>
                }
            }
        </section>
    </main>
    @if (!string.IsNullOrWhiteSpace(message)) { <div class="toast @(ok ? "ok" : "error")">@message</div> }
}

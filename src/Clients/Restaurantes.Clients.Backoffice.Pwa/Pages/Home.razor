@page "/"
@using System.Text.Json
@using Syncfusion.Blazor.Navigations
@inject BackofficeApi Api
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject Restaurantes.Clients.Backoffice.Pwa.Security.SessionAuthenticationStateProvider AuthState

<PageTitle>Backoffice · Restaurantes</PageTitle>

@if (initializing)
{
    <main class="login-shell">
        <section class="login-card session-check-card" aria-live="polite">
            <img class="brand-icon" src="icons/icon-192.png" alt="" />
            <p class="muted">Comprobando sesión…</p>
        </section>
    </main>
}
else if (login is null)
{
    <main class="login-shell">
        <section class="login-card">
            <div class="login-brand">
                <img class="brand-icon" src="icons/icon-192.png" alt="" />
                <div><p class="eyebrow">RESTAURANTES · ADMINISTRACIÓN</p><h1>Backoffice</h1></div>
            </div>
            <div class="login-providers">
                <button class="primary full" type="button" @onclick='() => StartLogin("Microsoft")'
                        disabled="@(providerSettings is null || providerSettings.ActiveProvider != "Microsoft" || !MicrosoftConfigured)">
                    Iniciar sesión con Microsoft
                </button>
                <button class="primary full" type="button" @onclick='() => StartLogin("Google")'
                        disabled="@(providerSettings is null || providerSettings.ActiveProvider != "Google" || !GoogleConfigured)">
                    Iniciar sesión con Google
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <p class="error">@message</p>
            }
        </section>
    </main>
}
else
{
    <header class="topbar">
        <div class="topbar-brand">
            <button class="sidebar-menu-toggle" type="button" aria-label="Abrir o cerrar el menú" aria-expanded="@sidebarOpen" @onclick="ToggleSidebar">
                <span aria-hidden="true">☰</span>
            </button>
            <div><p class="eyebrow">RESTAURANTES · BACKOFFICE</p><strong>@login.User.DisplayName</strong></div>
        </div>
        <div class="top-actions">
            <button class="secondary" @onclick="Logout">Salir</button>
        </div>
    </header>

    <div class="backoffice-shell">
        <SfSidebar @attributes="SidebarAttributes" @bind-IsOpen="sidebarOpen" Width="260px" Target=".workspace" Position="SidebarPosition.Left"
                   Type="SidebarType.Auto" Animate="true">
            <ChildContent>
                <aside class="sidebar" aria-label="Navegación del Backoffice">
                    <SfTreeView TValue="NavigationNode" CssClass="sidebar-tree" @bind-SelectedNodes="selectedNavigationNodes">
                        <TreeViewEvents TValue="NavigationNode" NodeSelecting="BeforeNavigationSelect" NodeSelected="OnNavigationSelected" />
                        <TreeViewFieldsSettings TValue="NavigationNode" Id="Id" Text="Text" ParentID="ParentId" HasChildren="HasChildren" Expanded="Expanded" DataSource="@NavigationNodes" />
                    </SfTreeView>
                </aside>
            </ChildContent>
        </SfSidebar>

        <main class="workspace">
            <section class="content">
                <div class="page-title">
                    <div><p class="eyebrow">@ModuleEyebrow</p><h1>@ModuleTitle</h1></div>
                    @if (ShowRestaurantContextSelector || RefreshLabel is not null)
                    {
                        <div class="context-header-actions">
                            @if (ShowRestaurantContextSelector)
                            {
                                <RestaurantContextSelector Host="this" />
                            }
                            @if (RefreshLabel is { } refreshLabel)
                            {
                                <button class="secondary" @onclick="RefreshCurrentModule" disabled="@busy">@refreshLabel</button>
                            }
                        </div>
                    }
                </div>

                @if (module == "catalog-design")
                {
                    @if (IsCurrentRestaurantManager)
                    {
                        <CatalogDesignModule Host="this" @ref="catalogDesignModule" />
                    }
                    else
                    {

                        <NoAccessPanel />
                    }
                }
                else if (module == "orders")
                {
                    @if (OrderRestaurants.Count > 0)
                    {
                        <OrdersModule Host="this" />
                    }
                    else
                    {

                        <NoAccessPanel />
                    }
                }
                else if (module == "daily-orders-report")
                {
                    @if (ReportRestaurants.Count > 0)
                    {
                        <OrdersModule Host="this" />
                    }
                    else
                    {
                        <NoAccessPanel />
                    }
                }
                else if (module == "stations")
                {
                    @if (IsCurrentRestaurantManager)
                    {
                        <StationsModule Host="this" />
                    }
                    else
                    {

                        <NoAccessPanel />
                    }
                }
                else if (module == "categories")
                {
                    <CategoriesModule Host="this" />
                }
                else if (module == "products")
                {
                    <ProductsModule Host="this" />
                }
                else if (module == "taxes")
                {
                    <TaxesModule Host="this" @ref="taxesModule" />
                }
                else if (module == "allergens")
                {
                    <AllergensModule Host="this" @ref="allergensModule" />
                }
                else if (module == "restaurants")
                {
                    <RestaurantsModule Host="this" />
                }
                else if (module == "companies")
                {
                    <CompaniesModule Host="this" />
                }
                else if (module == "users")
                {
                    <UsersModule Host="this" />
                }
                else if (module == "tables")
                {
                    <TablesModule Host="this" />
                }
                else if (module == "zones")
                {
                    <ZonesModule Host="this" />
                }
            </section>
        </main>
    </div>
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="toast @(ok ? "ok" : "error")">@message</div>
    }
}
@if (selectedOrder is not null)
{
    <div class="order-details-overlay">
        <article class="order-details">
            <div class="order-details-actions">
                <button class="secondary" @onclick="PrintOrderDetails">Imprimir</button>
                <button class="secondary" @onclick="CloseOrderDetails">Cerrar</button>
            </div>
            <header class="order-ticket-header">
                <h2>Copia del pedido</h2>
                <strong>@RestaurantName(selectedOrder.RestaurantId)</strong>
                <span>@(string.IsNullOrEmpty(selectedOrder.TableLabel) ? selectedOrder.CustomerName : selectedOrder.TableLabel)</span>
                <span>@selectedOrder.CreatedAtLocal.ToString("dd/MM/yyyy HH:mm")</span>
                <span>Pedido @selectedOrder.Id</span>
                <span>@selectedOrder.Source · @selectedOrder.Status</span>
                @if (selectedOrder.PaymentMethod is not null && selectedOrder.PaymentCapturedAtLocal is not null)
                {
                    <span>Forma de pago: @PaymentMethodLabel(selectedOrder.PaymentMethod)</span>
                    <span>Pagado: @selectedOrder.PaymentCapturedAtLocal.Value.ToString("dd/MM/yyyy HH:mm")</span>
                }
            </header>
            <hr />
            @foreach (ManagementOrderLineResponse line in selectedOrder.Lines)
            {
                <div class="order-ticket-line">
                    <span>@line.Quantity × @line.ProductName @if (line.Status == "Cancelled") {
                        <small>(Cancelado)</small>
                    }
                </span>
                <strong>@((line.Quantity * line.UnitPrice).ToString("0.00")) €</strong>
            </div>
        }
        <hr />
        <div class="order-ticket-total"><strong>Total</strong><strong>@selectedOrder.Total.ToString("0.00") €</strong></div>
        <p class="order-ticket-copy">Copia del pedido</p>
    </article>
</div>
}

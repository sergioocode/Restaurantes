@page "/"
@using System.Text.Json
@implements IAsyncDisposable
@inject PosApi Api
@inject OrderRealtimeClient Realtime
@inject DiningRealtimeClient DiningRealtime
@inject IJSRuntime Js

<PageTitle>TPV · Restaurantes</PageTitle>

<main class="pos-shell">
    @if (login is null)
    {
        <section class="login-card">
            <div class="brand-mark">TPV</div>
            <p class="eyebrow">RESTAURANTES · PUNTO DE VENTA</p>
            <h1>Caja del local</h1>
            <p class="muted">Acceso exclusivo del personal autorizado.</p>
            <form @onsubmit="DoLogin" @onsubmit:preventDefault>
                <label>Usuario<input autocomplete="username" @bind="username" /></label>
                <label>Contraseña<input type="password" autocomplete="current-password" @bind="password" /></label>
                <button class="primary full" disabled="@busy">@(busy ? "Entrando…" : "Entrar al TPV")</button>
            </form>
            @if (!string.IsNullOrWhiteSpace(message)) { <p class="form-error">@message</p> }
            <p class="dev-hint">Desarrollo: camarero1.mad-centro / Camarero-01-1-2026!</p>
        </section>
    }
    else
    {
        <header class="topbar">
            <div>
                <p class="eyebrow">TPV · PUNTO DE VENTA</p>
                <strong>@login.User.DisplayName</strong>
            </div>
            <div class="top-actions">
                <select aria-label="Local" value="@restaurantId" @onchange="RestaurantChanged">
                    @foreach (RestaurantAccess access in login.Restaurants)
                    {
                        <option value="@access.RestaurantId">@access.RestaurantId · @access.Role</option>
                    }
                </select>
                <button class="cash-status @(CashRegisterOpen ? "open" : "closed")" @onclick="OpenCashRegisterPanel">
                    Caja · @(CashRegisterOpen ? "abierta" : "cerrada")
                </button>
                <button class="ghost" @onclick="Logout">Salir</button>
            </div>
        </header>

        @if (selectedTable is null && serviceMode != "Takeaway")
        {
            <section class="tables-view">
                <div class="section-title">
                    <div><p class="eyebrow">COMANDAS</p><h2>Seleccionar ubicación</h2></div>
                    <div class="filters">
                        <button class="quick-mode" @onclick='() => BeginTakeaway()' disabled="@(!CashRegisterOpen)">Nuevo para llevar</button>
                        <button class="ghost" @onclick="LoadPickupOrders" disabled="@busy">Recogidas (@pickupOrders.Count)</button>
                        <button class="@FilterClass("All")" @onclick='() => tableFilter = "All"'>Todas</button>
                        <button class="@FilterClass("Available")" @onclick='() => tableFilter = "Available"'>Disponibles</button>
                        <button class="@FilterClass("Occupied")" @onclick='() => tableFilter = "Occupied"'>Ocupadas</button>
                        <button class="ghost" @onclick="LoadTables" disabled="@busy">Actualizar</button>
                    </div>
                </div>
                @foreach (var zone in FilteredTables.OrderBy(x => x.ZoneSortOrder).ThenBy(x => x.ZoneName).ThenBy(x => x.Code).GroupBy(x => new { x.ZoneId, x.ZoneName }))
                {
                    <section class="dining-zone" @key="zone.Key.ZoneId">
                        <h3>@zone.Key.ZoneName <small>(@zone.Count())</small></h3>
                        <div class="table-grid">
                            @foreach (TableResponse table in zone)
                            {
                                <button class="table-card @table.Status.ToLowerInvariant()"
                                        @onclick="() => SelectTable(table)" disabled="@(busy || (!CashRegisterOpen && table.Status != "Occupied"))">
                                    <span class="table-status">@StatusLabel(table.Status)</span>
                                    <strong>@table.Label</strong>
                                    <small>@table.Code</small>
                                    @if (table.Status == "Occupied")
                                    {
                                        <small class="order-progress">@TableOrderSummary(table)</small>
                                    }
                                    <em>@(table.Status == "Occupied" ? "Abrir cuenta activa" : "Abrir ubicación")</em>
                                </button>
                            }
                        </div>
                    </section>
                }
                @if (FilteredTables.Count == 0 && !busy) { <p class="empty">No hay ubicaciones para este filtro.</p> }

                <div class="section-title pickup-title">
                    <div><p class="eyebrow">PARA LLEVAR</p><h2>Recogidas activas</h2></div>
                    <button class="ghost" @onclick="LoadPickupOrders" disabled="@busy">Actualizar</button>
                </div>
                <div class="table-grid">
                    @foreach (OrderResponse pickup in pickupOrders)
                    {
                        <article class="table-card occupied pickup-card">
                            <span class="table-status">@OrderProgress.PickupLabel(pickup.Status)</span>
                            <strong>@pickup.CustomerName</strong>
                            <small>@pickup.Id.ToString()[..8] · @pickup.CreatedAtUtc.ToLocalTime().ToString("HH:mm")</small>
                            <em>@(pickup.PaymentTiming == "Immediate" ? "Pagado" : "Pendiente de cobro") · @pickup.Total.ToString("0.00") €</em>
                            @if (OrderProgress.IsReady(pickup.Status))
                            {
                                <button class="primary" @onclick="() => CompletePickup(pickup)" disabled="@(busy || (pickup.PaymentTiming != "Immediate" && !CashRegisterOpen))">
                                    @(pickup.PaymentTiming == "Immediate" ? "Entregar al cliente" : "Cobrar y entregar")
                                </button>
                            }
                        </article>
                    }
                </div>
                @if (pickupOrders.Count == 0 && !busy) { <p class="empty">No hay pedidos pendientes de recogida.</p> }
            </section>
        }
        else
        {
            <section class="sale-layout">
                <div class="catalog-panel">
                @if (session is { RequestGuestCount: true, GuestCount: null })
                {
                    <section class="guest-count">
                        <label>¿Cuántos comensales van a comer?
                            <input type="number" min="1" max="999" placeholder="Cantidad de comensales" @bind="guestCount" disabled="@busy" />
                        </label>
                        <p>Indica la cantidad antes de enviar el primer pedido.</p>
                    </section>
                }
                else if (session?.GuestCount is int savedGuestCount)
                {
                    <p class="guest-count">Comensales: @savedGuestCount</p>
                }
                    <div class="order-head">
                        <button class="back" @onclick="BackToTables">← Comandas</button>
                        <div>
                            <p class="eyebrow">@ModeLabel(serviceMode) · ORIGEN POS</p>
                            <h2>@CurrentLabel</h2>
                        </div>
                        @if (HasPhysicalLocation)
                        {
                            <button class="ghost" @onclick="OpenBill">Cuenta</button>
                        }
                    </div>

                    @if (HasPhysicalLocation && session is not null)
                    {
                        <div class="session-progress">
                            <strong>Estado de comandas</strong>
                            <span>@SessionOrderSummary(session.Id)</span>
                        </div>
                    }

                    <div class="category-tabs">
                        <button class="@CategoryClass(null)" @onclick="() => category = null">Todo</button>
                        @foreach (string itemCategory in Categories)
                        {
                            <button class="@CategoryClass(itemCategory)" @onclick="() => category = itemCategory">@itemCategory</button>
                        }
                    </div>

                    <div class="product-grid">
                        @foreach (MenuItemResponse item in VisibleMenu)
                        {
                            <button class="product-tile" @onclick="() => ChangeQuantity(item.ProductId, 1)">
                                <span>@item.CategoryName</span>
                                <strong>@item.ProductName</strong>
                                <em>@item.Price.ToString("0.00") €</em>
                            </button>
                        }
                    </div>
                </div>

                <aside class="ticket-panel">
                    <div class="ticket-title"><div><p class="eyebrow">TICKET ACTUAL</p><h2>@CurrentLabel</h2></div><span>@ItemCount uds.</span></div>
                    <div class="ticket-lines">
                        @foreach (MenuItemResponse item in Cart)
                        {
                            <article>
                                <div class="line-main"><strong>@item.ProductName</strong><span>@(item.Price * quantities[item.ProductId]) €</span></div>
                                <div class="stepper">
                                    <button @onclick="() => ChangeQuantity(item.ProductId, -1)">−</button>
                                    <span>@quantities[item.ProductId]</span>
                                    <button @onclick="() => ChangeQuantity(item.ProductId, 1)">+</button>
                                </div>
                                <input placeholder="Nota para cocina" @bind="notes[item.ProductId]" />
                            </article>
                        }
                        @if (Cart.Count == 0) { <p class="empty">Pulsa un producto para añadirlo.</p> }
                    </div>
                    <div class="ticket-total"><span>Total de esta tanda</span><strong>@Total.ToString("0.00") €</strong></div>
                    @if (!HasPhysicalLocation)
                    {
                        <label>Nombre para la recogida
                            <input maxlength="80" placeholder="Ej. Lucía" @bind="customerName" />
                        </label>
                        @if (takeawayRequiresPrepayment)
                        {
                            <label class="quick-payment">Cobro antes de cocina
                                <select @bind="quickPaymentMethod">
                                    <option value="Card">Tarjeta</option>
                                    <option value="Cash">Efectivo</option>
                                </select>
                            </label>
                            @if (quickPaymentMethod == "Cash" && !CashRegisterOpen)
                            {
                                <p class="warning">Abre la caja diaria antes de cobrar en efectivo.</p>
                            }
                        }
                        else
                        {
                            <p class="muted">Este local cobra el pedido cuando el cliente lo recoge.</p>
                        }
                    }
                    <button class="primary full" disabled="@(busy || !CashRegisterOpen || ItemCount == 0 || (!HasPhysicalLocation && string.IsNullOrWhiteSpace(customerName)))" @onclick="SendOrder">
                        @(busy ? "Procesando…" : HasPhysicalLocation ? "Enviar a cocina" : takeawayRequiresPrepayment ? "Confirmar cobro y enviar" : "Enviar a cocina · cobrar al recoger")
                    </button>
                    @if (CanCancelSession)
                    {
                        <div class="cancel-box">
                            <input placeholder="Motivo para cancelar la apertura" @bind="cancelReason" />
                            <button class="danger full" disabled="@(busy || cancelReason.Trim().Length < 3)" @onclick="CancelSession">
                                Cancelar ubicación vacía
                            </button>
                        </div>
                    }
                </aside>
            </section>

            @if (billOpen)
            {
                <div class="modal-backdrop" @onclick="CloseBill">
                    <section class="bill-card" @onclick:stopPropagation>
                        <div class="bill-title">
                            <div><p class="eyebrow">CUENTA</p><h2>@CurrentLabel</h2></div>
                            <button class="ghost" @onclick="CloseBill">Cerrar</button>
                        </div>
                        @if (bill is null)
                        {
                            <p class="muted">Cargando cuenta…</p>
                        }
                        else
                        {
                            <div class="bill-orders">
                                @foreach (SessionBillOrderResponse order in bill.Orders)
                                {
                                    <article>
                                        <div><strong>Comanda @order.OrderId.ToString()[..8]</strong><small>@order.AddedAtUtc.ToLocalTime().ToString("HH:mm")</small></div>
                                        <div><span>@order.OrderStatus</span><span>@order.PaymentStatus</span><strong>@order.Amount.ToString("0.00") €</strong></div>
                                        @if (billOrders.TryGetValue(order.OrderId, out OrderDetailResponse? detail))
                                        {
                                            <div class="bill-lines">
                                                @foreach (OrderLineDetailResponse line in detail.Lines)
                                                {
                                                    <div class="bill-line @(line.Status == "Cancelled" ? "cancelled" : "")">
                                                        <span>@line.Quantity × @line.ProductName · @line.PreparationStationName</span>
                                                        @if (CanCancelLine(order, detail, line))
                                                        {
                                                            <button class="danger" disabled="@busy" @onclick="() => CancelLine(order, line)">Cancelar</button>
                                                        }
                                                        else if (line.Status == "Cancelled")
                                                        {
                                                            <small>Cancelado · @line.CancellationReason</small>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </article>
                                }
                            </div>
                            <div class="bill-total"><span>Total</span><strong>@bill.Total.ToString("0.00") €</strong></div>
                            <div class="bill-total outstanding"><span>Pendiente</span><strong>@bill.Outstanding.ToString("0.00") €</strong></div>
                            @if (!bill.CanCheckout)
                            {
                                <p class="warning">Solo se puede cobrar cuando todas las comandas estén terminadas en cocina.</p>
                            }
                            <label>Método de pago
                                <select @bind="paymentMethod"><option value="Card">Tarjeta</option><option value="Cash">Efectivo</option></select>
                            </label>
                            @if (paymentMethod == "Cash" && !CashRegisterOpen)
                            {
                                <p class="warning">Abre la caja diaria antes de cobrar esta cuenta en efectivo.</p>
                            }
                            <label>Referencia (opcional)<input @bind="paymentReference" placeholder="Ticket de caja o datáfono" /></label>
                            <div class="bill-actions">
                                <button class="ghost" @onclick="OpenBill" disabled="@busy">Actualizar</button>
                                @if (bill.Outstanding == 0)
                                {
                                    <button class="primary" @onclick="ReleaseSession" disabled="@busy">
                                        @(busy ? "Liberando…" : "Liberar mesa")
                                    </button>
                                }
                                else
                                {
                                    <button class="primary" @onclick="CheckoutSession" disabled="@(busy || !bill.CanCheckout || !CashRegisterOpen)">
                                        @(busy ? "Cobrando…" : "Cobrar y liberar mesa")
                                    </button>
                                }
                            </div>
                        }
                    </section>
                </div>
            }
        }

        @if (cashPanelOpen)
        {
            <div class="modal-backdrop" @onclick="CloseCashRegisterPanel">
                <section class="bill-card cash-register-card" @onclick:stopPropagation>
                    <div class="bill-title">
                        <div><p class="eyebrow">CAJA · DÍA OPERATIVO</p><h2>@(CashRegisterOpen ? "Turno abierto" : cashRegister?.Status == "Closed" ? "Arqueo cerrado" : "Abrir turno")</h2></div>
                        <button class="ghost" @onclick="CloseCashRegisterPanel">Cerrar</button>
                    </div>
                    @if (cashRegister is null)
                    {
                        <p class="muted">Indica el efectivo inicial disponible en el cajón.</p>
                        <label>Fondo inicial<input type="number" min="0" step="0.01" @bind="openingFloat" /></label>
                        <button class="primary full" @onclick="OpenDailyCashRegister" disabled="@busy">@(busy ? "Abriendo…" : "Abrir turno de caja")</button>
                    }
                    else
                    {
                        <div class="cash-metrics">
                            <div><span>Ventas totales</span><strong>@cashRegister.TotalSales.ToString("0.00") €</strong></div>
                            <div><span>Devoluciones totales</span><strong>@cashRegister.TotalRefunds.ToString("0.00") €</strong></div>
                            <div><span>Total esperado</span><strong>@cashRegister.ExpectedTotal.ToString("0.00") €</strong></div>
                            <div><span>Fondo inicial</span><strong>@cashRegister.OpeningFloat.ToString("0.00") €</strong></div>
                            <div><span>Ventas efectivo</span><strong>@cashRegister.CashSales.ToString("0.00") €</strong></div>
                            <div><span>Devoluciones</span><strong>@cashRegister.CashRefunds.ToString("0.00") €</strong></div>
                            <div><span>Efectivo esperado</span><strong>@cashRegister.ExpectedCash.ToString("0.00") €</strong></div>
                        </div>
                        @if (cashRegister.PaymentMethods.Count > 0)
                        {
                            <div class="cash-methods">
                                @foreach (PaymentMethodTotal method in cashRegister.PaymentMethods)
                                {
                                    <div><span>@PaymentLabel(method.Method)</span><strong>@method.Net.ToString("0.00") €</strong></div>
                                }
                            </div>
                        }
                        @if (CashRegisterOpen)
                        {
                            <button class="ghost full" @onclick="RefreshCashRegister" disabled="@busy">Actualizar movimientos</button>
                            <h3>Conciliación del turno</h3>
                            @foreach (PaymentMethodExpected method in cashRegister.ExpectedByMethod)
                            {
                                <label>@PaymentLabel(method.Method) · esperado @method.Expected.ToString("0.00") €
                                    <input type="number" min="0" step="0.01" @bind="reconciliationAmounts[method.Method]" />
                                </label>
                            }
                            <div class="cash-difference"><span>Diferencia total provisional</span><strong class="@(ReconciliationDifference == 0 ? "balanced" : "unbalanced")">@ReconciliationDifference.ToString("+0.00;-0.00;0.00") €</strong></div>
                            <button class="danger full" @onclick="CloseDailyCashRegister" disabled="@busy">@(busy ? "Cerrando…" : "Cerrar y confirmar arqueo")</button>
                        }
                        else
                        {
                            @foreach (PaymentMethodReconciliation item in cashRegister.Reconciliations)
                            {
                                <div class="cash-difference"><span>@PaymentLabel(item.Method): conciliado @item.Reconciled.ToString("0.00") € / esperado @item.Expected.ToString("0.00") €</span><strong class="@(item.Difference == 0 ? "balanced" : "unbalanced")">@item.Difference.ToString("+0.00;-0.00;0.00") €</strong></div>
                            }
                            <div class="cash-difference"><span>Descuadre total</span><strong class="@(cashRegister.Difference == 0 ? "balanced" : "unbalanced")">@cashRegister.Difference?.ToString("+0.00;-0.00;0.00") €</strong></div>
                            <label>Fondo del nuevo turno<input type="number" min="0" step="0.01" @bind="openingFloat" /></label>
                            <button class="primary full" @onclick="OpenDailyCashRegister" disabled="@busy">Abrir otro turno hoy</button>
                        }
                    }
                </section>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="toast @(success ? "success" : "error")">@message</div>
        }
    }
</main>

